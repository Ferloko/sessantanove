# ── Fleeca (banco de GTA World) ───────────────────────────────────────────────
# Clave Bearer del Merchant Center de Fleeca. Sin ella la tienda funciona en MODO DEMO
# (pasarela simulada, no se mueve dinero).
FLEECA_API_KEY=
# 0 = sandbox (pruebas), 1 = real.
FLEECA_MODE=0
# Banco del servidor. Español: https://banking-es.gta.world · Inglés: https://banking.gta.world
FLEECA_BASE_URL=https://banking-es.gta.world

# ── Tienda ────────────────────────────────────────────────────────────────────
# Secreto largo y aleatorio para firmar los pedidos (obligatorio en producción).
ORDER_SECRET=
# URL pública de la web (opcional; si falta se deduce de la petición).
SITE_URL=
# Webhook de Discord donde llegan los pedidos (opcional pero recomendado).
DISCORD_WEBHOOK_URL=
